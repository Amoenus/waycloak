{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "runtimeNamespace", "runtimeRelease", "overlayCIDR"],
  "properties": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "const": "ghcr.io/amoenus/waycloak-replacement-controller"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always"]}
      }
    },
    "runtimeNamespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
    "runtimeRelease": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 40},
    "version": {"type": "string", "pattern": "^$|^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "overlayCIDR": {"type": "string", "minLength": 1},
    "nodeArchitecture": {"enum": ["", "amd64", "arm64"]},
    "adoptExisting": {"type": "boolean"},
    "suspend": {"type": "boolean"},
    "config": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "controllerResources": {"$ref": "#/definitions/resources"},
        "nodeAgentResources": {"$ref": "#/definitions/resources"},
        "installerResources": {"$ref": "#/definitions/resources"},
        "controllerNodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "controllerTolerations": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
        "portForwarding": {
          "type": "object", "additionalProperties": false, "required": ["controllerTLSSecret"],
          "properties": {
            "controllerTLSSecret": {"type": "string", "minLength": 1},
            "adapterEnabled": {"type": "boolean"}
          }
        }
      }
    },
    "resources": {"$ref": "#/definitions/resources"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "healthPort": {"type": "integer", "minimum": 1024, "maximum": 65535}
  },
  "definitions": {
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requests": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
        "limits": {"type": "object", "additionalProperties": {"type": ["string", "number"]}}
      }
    }
  }
}
