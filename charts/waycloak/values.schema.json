{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "defaultGatewayClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "releaseIdentity"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
        "releaseIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "manifestDigest"],
          "properties": {
            "version": {"type": "string", "maxLength": 128},
            "manifestDigest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "observationRelayURL", "observationCASecret", "cniReceiptHostPath", "cniBinaryHostPath", "cniConfigHostPath", "reconcileInterval", "conformanceProfile", "releaseIdentity"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        },
        "observationRelayURL": {"type": "string"},
        "observationCASecret": {"type": "string"},
        "cniReceiptHostPath": {"type": "string"},
        "cniBinaryHostPath": {"type": "string"},
        "cniConfigHostPath": {"type": "string"},
        "reconcileInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "conformanceProfile": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$"},
        "releaseIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "manifestDigest"],
          "properties": {
            "version": {"type": "string", "maxLength": 128},
            "manifestDigest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    }
  }
}
