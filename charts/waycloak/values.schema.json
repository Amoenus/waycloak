{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "observationRelayURL", "observationCASecret", "reconcileInterval"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        },
        "observationRelayURL": {"type": "string"},
        "observationCASecret": {"type": "string"},
        "reconcileInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"}
      }
    }
  }
}
