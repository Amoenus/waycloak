{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "assets"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "port"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifestDigest"],
      "properties": {
        "version": {"type": "string", "maxLength": 128},
        "manifestDigest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicas", "observationTLSSecret", "observationPort", "conformanceProfile", "gateway"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        },
        "replicas": {"type": "integer", "minimum": 1, "maximum": 3},
        "observationTLSSecret": {"type": "string"},
        "observationPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "conformanceProfile": {"type": "string", "minLength": 1},
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engineImage", "agentImage", "overlayCIDR", "vni", "mtu", "vxlanPort", "healthPort"],
          "properties": {
            "engineImage": {
              "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
              "properties": {"repository": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}}
            },
            "agentImage": {
              "type": "object", "additionalProperties": false, "required": ["repository", "digest"],
              "properties": {"repository": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}}
            },
            "overlayCIDR": {"type": "string"},
            "vni": {"type": "integer", "minimum": 1, "maximum": 16777215},
            "mtu": {"type": "integer", "minimum": 576, "maximum": 9000},
            "vxlanPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "healthPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "cniInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "nodeSelector", "image", "pauseImage", "configHostPath", "binaryHostPath", "receiptHostPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        },
        "pauseImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        },
        "configHostPath": {"type": "string"},
        "binaryHostPath": {"type": "string"},
        "receiptHostPath": {"type": "string"}
      }
    },
    "defaultGatewayClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "releaseIdentity"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
        "releaseIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "manifestDigest"],
          "properties": {
            "version": {"type": "string", "maxLength": 128},
            "manifestDigest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "observationRotationID", "nodeSelector", "image", "observationRelayURL", "observationCASecret", "cniReceiptHostPath", "cniBinaryHostPath", "cniConfigHostPath", "reconcileInterval", "conformanceProfile", "releaseIdentity"],
      "properties": {
        "enabled": {"type": "boolean"},
        "observationRotationID": {"type": "string", "pattern": "^(initial|sha256:[a-f0-9]{64})$"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        },
        "observationRelayURL": {"type": "string"},
        "observationCASecret": {"type": "string"},
        "cniReceiptHostPath": {"type": "string"},
        "cniBinaryHostPath": {"type": "string"},
        "cniConfigHostPath": {"type": "string"},
        "reconcileInterval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "conformanceProfile": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?)?$"},
        "releaseIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "manifestDigest"],
          "properties": {
            "version": {"type": "string", "maxLength": 128},
            "manifestDigest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    }
  }
}
