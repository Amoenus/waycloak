{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waycloak.io/schemas/workload-adapter-v1.json",
  "title": "Waycloak workload adapter protocol v1",
  "$defs": {
    "uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "leaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "leaseNamespace", "leaseUID", "handoffGeneration", "podUID", "publicAddress", "publicPort", "expiresAt", "targetPort", "applicationAddress", "backendPort", "protocols"],
      "properties": {
        "apiVersion": { "const": "networking.waycloak.io/adapter/v1" },
        "leaseNamespace": { "type": "string", "minLength": 1, "maxLength": 63 },
        "leaseUID": { "$ref": "#/$defs/uid" },
        "handoffGeneration": { "type": "integer", "minimum": 1 },
        "podUID": { "$ref": "#/$defs/uid" },
        "publicAddress": { "type": "string", "format": "ipv4" },
        "publicPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "applicationAddress": { "type": "string", "format": "ipv4" },
        "backendPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["TCP", "UDP"] }
        }
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "leaseNamespace", "leaseUID", "handoffGeneration", "podUID", "observedAt", "expiresAt"],
      "properties": {
        "apiVersion": { "const": "networking.waycloak.io/adapter/v1" },
        "leaseNamespace": { "type": "string", "minLength": 1, "maxLength": 63 },
        "leaseUID": { "$ref": "#/$defs/uid" },
        "handoffGeneration": { "type": "integer", "minimum": 1 },
        "podUID": { "$ref": "#/$defs/uid" },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "withdrawalAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "leaseNamespace", "leaseUID", "handoffGeneration", "podUID", "observedAt", "withdrawn"],
      "properties": {
        "apiVersion": { "const": "networking.waycloak.io/adapter/v1" },
        "leaseNamespace": { "type": "string", "minLength": 1, "maxLength": 63 },
        "leaseUID": { "$ref": "#/$defs/uid" },
        "handoffGeneration": { "type": "integer", "minimum": 1 },
        "podUID": { "$ref": "#/$defs/uid" },
        "observedAt": { "type": "string", "format": "date-time" },
        "withdrawn": { "const": true }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "namespace", "name", "image", "podUID", "observedAt", "ready"],
      "properties": {
        "apiVersion": { "const": "networking.waycloak.io/adapter/v1" },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 63 },
        "name": { "type": "string", "minLength": 1, "maxLength": 63 },
        "image": { "type": "string", "minLength": 1 },
        "podUID": { "$ref": "#/$defs/uid" },
        "observedAt": { "type": "string", "format": "date-time" },
        "ready": { "type": "boolean" }
      }
    }
  }
}
