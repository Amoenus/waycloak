{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waycloak.io/schemas/release-manifest-v1.schema.json",
  "title": "Waycloak exact release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "version", "manifestDigest", "chart", "images", "profiles"],
  "properties": {
    "apiVersion": { "const": "release.waycloak.io/v1" },
    "version": { "type": "string", "minLength": 1 },
    "manifestDigest": {
      "allOf": [{ "$ref": "#/$defs/digest" }],
      "description": "SHA-256 of the canonical JSON identity containing apiVersion, version, chart, optional KCL module, images, and lexically sorted profiles; the manifestDigest field itself is excluded."
    },
    "chart": { "$ref": "#/$defs/artifact" },
    "kcl": {
      "allOf": [{ "$ref": "#/$defs/artifact" }],
      "description": "Exact optional KCL OCI module. Omitted only by release manifests published before RC packaging added the module."
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacement-controller", "waycloak-cni", "waycloak-node-agent", "waycloak-gateway-agent", "waycloak-gateway-runtime", "waycloak-qbittorrent-adapter", "gluetun", "pause"],
      "properties": {
        "replacement-controller": { "$ref": "#/$defs/artifact" },
        "waycloak-cni": { "$ref": "#/$defs/artifact" },
        "waycloak-node-agent": { "$ref": "#/$defs/artifact" },
        "waycloak-gateway-agent": { "$ref": "#/$defs/artifact" },
        "waycloak-gateway-runtime": { "$ref": "#/$defs/artifact" },
        "waycloak-qbittorrent-adapter": { "$ref": "#/$defs/artifact" },
        "gluetun": { "$ref": "#/$defs/artifact" },
        "pause": { "$ref": "#/$defs/artifact" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "networking.waycloak.io/Core-v1" },
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "pattern": "^[^@]+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
